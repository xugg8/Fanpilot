#!/bin/bash
# 由代理生成：P1 实测启动器（双击或 open 即可在终端中运行）
# 你只需要输入一次登录密码。
cd "$(cd "$(dirname "$0")/.." && pwd)" || { echo "找不到 FanPilot 仓库根"; read -n 1 -s -r; exit 1; }

clear
cat <<'BANNER'
╔══════════════════════════════════════════════════════════════╗
║  FanPilot · P1 实测（冷机 Ftst 解锁路径）                     ║
╠══════════════════════════════════════════════════════════════╣
║  将要执行： sudo ./Tools/p1-acceptance.sh                     ║
║  需要你做： 输入一次登录密码（终端不会显示字符，正常）        ║
║  预计耗时： 约 60 秒                                          ║
║  预期现象： 风扇加速到 3500 RPM（有风声，正常），随后自动交还 ║
║  安全兜底： 转速固定 3500 / 温度超 90°C 中止 / 90 秒死人开关  ║
║              / 结束强制校验已交还系统                         ║
╚══════════════════════════════════════════════════════════════╝

BANNER

LOG="/tmp/fanpilot_p1_$(date +%Y%m%d-%H%M%S).log"
echo "输出日志： $LOG"
echo "（跑完不需要复制粘贴 —— 代理可以直接读这个日志文件）"
echo

# script 会分配一个伪终端，保证 sudo 的密码提示正常显示，同时把全部输出写入日志
script -q "$LOG" sudo ./Tools/p1-acceptance.sh

echo
echo "════════════════════════════════════════════"
echo "✅ 已完成。日志： $LOG"
echo "   把这个路径告诉我（或直接说“跑完了”），我来分析。"
echo "════════════════════════════════════════════"
echo
echo "按任意键关闭此窗口…（窗口留着也行，终端可以照常使用）"
read -n 1 -s -r
